# Edit once, then source from every script. No secrets here.
export AWS_REGION="${AWS_REGION:-us-east-1}"
export NAME="ypnus-wp"
export INSTANCE_TYPE="t3.medium"
export VOLUME_GB="40"
export DOMAIN="ypnus.com"
export LE_EMAIL="ypnusa10@gmail.com"
# Restore inputs (Hostinger access is gone, so these come from a backup you hold)
export BACKUP_DB="${BACKUP_DB:-/root/restore/db.sql.gz}"            # mysqldump or UpdraftPlus/All-in-One WP Migration DB export
export BACKUP_CONTENT="${BACKUP_CONTENT:-/root/restore/wp-content.tar.gz}"  # wp-content (themes, uploads, plugins)
export REPO_DIR="${REPO_DIR:-/root/ypnusa}"                          # git clone of this repo (mu-plugins + plugins)
