[Unit]
Description=YPN USA scheduled follow-up processing
After=ypnusa.service
Wants=ypnusa.service

[Service]
Type=oneshot
User=ypnusa
Group=ypnusa
EnvironmentFile=/etc/ypnusa/app.env
ExecStart=/usr/local/sbin/ypnusa-followups
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
