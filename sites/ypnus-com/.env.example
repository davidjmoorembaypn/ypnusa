# Copy to a file OUTSIDE the web root (e.g. ~/ypnus-node.env) and point ENV_FILE at it,
# or set these in hPanel's Node.js environment-variables screen.
NODE_ENV=production
PORT=3000
SITE_URL=https://ypnus.com

# ZIP territory checks: proxy to the system that owns the ZIP ledger (leave empty to use data/zip-ledger.json)
ZIP_CHECK_UPSTREAM=

# Lead capture: every lead is saved to data/leads/leads.jsonl; also POST it here (Zapier/Make/CRM/app.ypnus.com)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Until /wp-content/uploads is copied into public/, redirect missing media here (e.g. an S3/CloudFront bucket)
MEDIA_FALLBACK_ORIGIN=

# Staging only: keep the preview out of search engines
NOINDEX=

# Google Analytics 4 (optional)
GA_MEASUREMENT_ID=
