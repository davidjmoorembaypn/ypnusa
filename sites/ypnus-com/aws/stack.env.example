# Settings for bash aws/deploy-stack.sh  (this copy, aws/stack.env, is git-ignored: keep it out of GitHub)
STACK_NAME=ypnus-site
APEX_DOMAIN=ypnus.com
# Your email for alarms and the monthly budget warning (AWS sends a "Confirm subscription" email once)
ALERT_EMAIL=
# Who gets each new lead / Stripe checkout email, and the sender address (must be @ypnus.com)
NOTIFY_EMAIL=support@ypnus.com
FROM_EMAIL=no-reply@ypnus.com
# Route 53 hosted zone ID for ypnus.com (step 2 of the guide). Leave empty until DNS is on Route 53.
HOSTED_ZONE_ID=
# false = preview on the cloudfront.net address only. true = attach ypnus.com + www (step 7). Traffic moves only at cutover.
USE_CUSTOM_DOMAIN=false
APP_URL=https://app.ypnus.com
ENABLE_WAF=true
SET_UP_SES=true
MONTHLY_BUDGET_USD=30
# owner/repo of the GitHub repository with the site, for automatic deploys (empty = skip)
GITHUB_REPO=
# false if this AWS account already has the GitHub OIDC provider (the deploy tells you if it does)
CREATE_GITHUB_OIDC=true
# ORIGIN_SECRET is generated on the first run and appended below. Do not share it.
